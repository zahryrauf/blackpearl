# --- Required ---
# MongoDB Atlas: copy the Driver connection string from Atlas and replace the
# username, password and cluster host. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/blackpearl?retryWrites=true&w=majority
AUTH_SECRET=change-me-to-a-long-random-string
SITE_URL=http://localhost:3000

# Admin account created by `pnpm seed`
ADMIN_EMAIL=admin@blackpearl.com
ADMIN_PASSWORD=admin123

# --- Email (SMTP). If empty, emails are printed to the server console ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Blackpearl Yachts <no-reply@blackpearl.example>"
INBOX_EMAIL=hello@blackpearl.example
SALES_EMAIL=sales@blackpearl.example
CHARTER_EMAIL=charter@blackpearl.example

# --- Stripe deposits (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEPOSIT_PERCENT=25

# --- Optional integrations ---
LEAD_WEBHOOK_URL=            # Slack/Zapier/Make URL, receives every new lead as JSON
NEXT_PUBLIC_WHATSAPP=        # digits only, e.g. 94771234567
NEXT_PUBLIC_GA_ID=           # Google Analytics 4 id, loads only after cookie consent
